# ── AI / device adapters ──────────────────────────────────────────────
# MOCK | ESP32_SERIAL | ESP32_HTTP
NEXT_PUBLIC_DEVICE_MODE=MOCK

# MOCK | PYTORCH
NEXT_PUBLIC_MODEL_MODE=MOCK

# ── backend API (Express) ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── camera mode ───────────────────────────────────────────────────────
# WEBCAM   → getUserMedia() — laptop webcam or RPi camera via V4L2 (/dev/video0)
# PICAMERA → calls /api/capture on the Express backend (RPi libcamera/picamera2)
NEXT_PUBLIC_CAMERA_MODE=WEBCAM

# ── ESP32 direct HTTP URL (only needed when DEVICE_MODE=ESP32_HTTP) ───
# Set to the IP address of your ESP32 on the local network
NEXT_PUBLIC_ESP32_URL=http://192.168.1.100
