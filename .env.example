# ── Camera ─────────────────────────────────────────────────────────
# WEBCAM   → getUserMedia() — laptop webcam or RPi camera via V4L2
# PICAMERA → calls /api/capture (Next.js internal route → rpicam-still)
NEXT_PUBLIC_CAMERA_MODE=WEBCAM

# ── Moisture sensor ────────────────────────────────────────────────
# MOCK         → manual text input (no hardware)
# ESP32_SERIAL → calls /api/moisture (Next.js internal route → USB serial)
# ESP32_HTTP   → calls ESP32's WiFi HTTP server directly
NEXT_PUBLIC_DEVICE_MODE=MOCK

# ── AI classifier ─────────────────────────────────────────────────
# MOCK    → random grade (simulation)
# PYTORCH → calls /api/classify (PyTorch FastAPI backend)
NEXT_PUBLIC_MODEL_MODE=PYTORCH

# ── Backend API (only needed for AI classifier later) ──────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── AI Model Checkpoint (efficientnet or resnet) ─────────────────
# MODEL_NAME=efficientnet    # EfficientNet-B0 + Attention Fusion
# MODEL_NAME=resnet          # ResNet-50 + Concat
MODEL_NAME=efficientnet

# ── ESP32 WiFi HTTP (only for DEVICE_MODE=ESP32_HTTP) ──────────────
NEXT_PUBLIC_ESP32_URL=http://192.168.1.100

# ── Serial port (server-side, only for DEVICE_MODE=ESP32_SERIAL) ───
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=115200
